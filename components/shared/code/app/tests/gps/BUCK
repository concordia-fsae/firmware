load("//tools/c_unit:defs.bzl", "c_unit_test")

GPS_SOURCES = [
    "test_gps.c",
    "//components/shared/code:app/app_gps.c",
    "//components/shared/code:libs/lib_yicGnss.c",
    "//components/shared/code:DRV/drv_timer.c",
    "//embedded/libs:lwgps[lwgps/src/lwgps/lwgps.c]",
]
GPS_HEADERS = {name: "include/" + name for name in [
    "BuildDefines.h", "test_lwgps_crc.h", "HW_uart.h", "HW_tim.h", "HW_gpio.h",
    "drv_outputAD.h", "app_faultManager.h", "Yamcan.h",
]} | {
    "lwgps/lwgps.h": "//embedded/libs:lwgps[lwgps/src/include/lwgps/lwgps.h]",
    "lwgps.h": "//embedded/libs:lwgps[lwgps/src/include/lwgps/lwgps.h]",
