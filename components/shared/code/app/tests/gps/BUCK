    "lwgps_opts.h": "//components/vc/front:lwgps_opts.h",
}

# All targets execute the same application-level scenarios with real parser/timer code.
[
    c_unit_test(
        name = name,
        srcs = GPS_SOURCES,
        headers = GPS_HEADERS,
        deps = [
            "//components/shared/code:headers",
            "//components/shared/code/RTOS:headers",
            "//tools/c_unit/support:freertos",
        ],
        compiler_flags = ["-include", "BuildDefines.h"] + flags,
        linker_flags = ["-lm"] + flags,
    )
    for name, flags in [
        ("gps_test", []),
        ("gps_crc_test", ["-include", "test_lwgps_crc.h"]),
        ("gps_sanitized", ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]),
    ]
]
