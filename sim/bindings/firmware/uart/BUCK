filegroup(name = "binding", srcs = glob(["*"]), visibility = ["PUBLIC"])

prebuilt_cxx_library(
    name = "headers",
    header_only = True,
    header_namespace = "",
    exported_headers = {
        file: file
        for file in glob(["*.h"])
    },
    visibility = ["PUBLIC"],
)

export_file(name = "uart.c", src = "uart.c", visibility = ["PUBLIC"])

export_file(name = "uart.rs", src = "uart.rs", visibility = ["PUBLIC"])

rust_test(
    name = "unit",
    crate = "uart",
    crate_root = "uart.rs",
    edition = "2024",
    srcs = ["uart.rs"],
    visibility = ["PUBLIC"],
)
