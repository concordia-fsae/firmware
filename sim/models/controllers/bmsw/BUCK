# The component build has a separate feature tree, YamCan network, and
# firmware image for every worker node.  Expose those configured builds as
# model-library aliases so each Rig node loads the matching firmware image
# instead of silently reusing node 0.
[
    native.configured_alias(
        name = "sil-so-{}-node-{}".format(platform_output_name(platform), node),
        actual = ":sil-so",
        platform = "//components/bms_worker:{}".format(
            configured_platform_name(platform, node)
        ),
        visibility = ["PUBLIC"],
    )
    for platform, node_count in [
        (PLATFORMS.CFR25, BMSW_NODE_COUNT_BY_PLATFORM["cfr25"]),
        (PLATFORMS.CFR26, BMSW_NODE_COUNT_BY_PLATFORM["cfr26"]),
    ]
    for node in range(node_count)
]

rig_python_enums(
    name = "enums-py-cfr26",
    out = "enums_cfr26.py",
    include_headers = ["drv_inputAD_componentSpecific.h"],
    deps = [
        "//components/bms_worker:feature-tree-cfr26",
        "//components/bms_worker:sil-yamcan-c",
        "//components/bms_worker:sil-host-headers",
        "//components/shared/code:headers",
        "//components/shared/code/RTOS:headers",
        "//sim/bindings/firmware/runtime:headers",
        "//sim/bindings/firmware/can:headers",
        "//sim/bindings/firmware/io:headers",
    ],
    c_enums = [
        "drv_inputAD_channelAnalog_E:AnalogInput:DRV_INPUTAD_ANALOG_::upper",
    ],
    clang_flags = [
        "-DBMSW_VARIANT_ID=1",
        "-DBMSW_NODE_ID=0",
        "-include",
        "BuildDefines.h",
        "-fshort-enums",
    ],
    visibility = ["PUBLIC"],
)
